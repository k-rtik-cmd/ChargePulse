# ChargePulse configuration. Copy to .env (never commit .env) and fill in.
#   cp .env.example .env

# ---------------------------------------------------------------- serving
POSTGRES_USER=chargepulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chargepulse
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-too

# ------------------------------------------------------------ S3 (batch path)
# AWS (EC2 / Learner Lab): globally unique bucket name, leave S3_ENDPOINT_URL
# empty. Credentials: attach LabInstanceProfile to the instance (preferred),
# or paste the temporary keys from Learner Lab "AWS Details" (they expire with
# the session).
S3_BUCKET=chargepulse-yourteam-2026
AWS_DEFAULT_REGION=us-east-1
S3_ENDPOINT_URL=
S3_CREATE_BUCKET=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Local development without AWS: run an S3-compatible store in Compose.
# Set these instead (the access key and secret become the store's root login):
#   COMPOSE_PROFILES=local-s3
#   S3_ENDPOINT_URL=http://minio:9000
#   AWS_ACCESS_KEY_ID=chargepulse-local
#   AWS_SECRET_ACCESS_KEY=<at least 8 characters>
COMPOSE_PROFILES=

# ------------------------------------------------------------------ producer
EVENT_RATE=50                 # events per second
DUPLICATE_RATE=0.02           # share of records that re-send an earlier event
LATE_RATE=0.03                # share of events with event_ts pushed into the past
LATE_MIN_SECONDS=30
LATE_MAX_SECONDS=240
INVALID_RATE=0.002            # share of malformed events (routed to dead-letter)
SETTLEMENT_MISMATCH_RATE=0.05 # share of settlements that disagree with the meter

# --------------------------------------------------------------- speed layer
SPEED_WATERMARK="2 minutes"
SPEED_TRIGGER="10 seconds"

# --------------------------------------------------------------- batch layer
BATCH_INTERVAL_SECONDS=3600   # hourly; runs at hh:00 + grace
BATCH_GRACE_SECONDS=300       # wait for late events before closing an hour
BATCH_LOOKBACK_HOURS=48       # re-check this many hours for late raw data
LATE_THRESHOLD_SECONDS=120    # events this late are counted as "late" in batch_runs

# ------------------------------------------------------------- memory sizing
# Defaults suit a t3.xlarge (16 GB). On a 2 GB t3.small (the largest type the
# AWS Academy Data Engineering sandbox allows) use 384m / 640m / 640m + swap.
KAFKA_HEAP_OPTS="-Xms512m -Xmx1g"
SPEED_DRIVER_MEMORY=1g
BATCH_DRIVER_MEMORY=1g
