  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Throughput (events/s, last 5 min)",
      "description": "Unique valid events per second seen by the speed layer over the last 5 complete minutes.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "chargepulse-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 25
              },
              {
                "color": "green",
                "value": 45
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "chargepulse-pg"
          },
          "rawSql": "SELECT COALESCE(SUM(event_count), 0) / 300.0 AS events_per_second\nFROM speed_view\nWHERE window_start >= date_trunc('minute', now()) - interval '5 minutes'\n  AND window_start <  date_trunc('minute', now())",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    },
