    {
      "id": 11,
      "type": "table",
      "title": "Batch reconciliation of the speed layer (per hour)",
      "description": "For each hour the batch layer has processed: the speed estimate vs the authoritative batch result.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "chargepulse-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
