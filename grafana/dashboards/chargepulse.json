      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "chargepulse-pg"
          },
          "rawSql": "SELECT hour_start AS \"hour (UTC)\", speed_events, batch_events,\n       speed_energy_kwh, batch_energy_kwh,\n       ROUND(batch_energy_kwh - speed_energy_kwh, 3) AS correction_kwh,\n       duplicates_removed, late_events, invalid_rows, dead_letter_rows,\n       run_count, finished_at\nFROM layer_comparison\nORDER BY hour_start DESC\nLIMIT 48",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    },
