    {
      "id": 4,
      "type": "stat",
      "title": "Batch boundary (UTC)",
      "description": "End of the last hour recomputed by the batch layer. Before it: batch rows; from it on: speed rows.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "chargepulse-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "chargepulse-pg"
          },
          "rawSql": "SELECT CASE WHEN batch_boundary = '-infinity' THEN 'no batch run yet'\n            ELSE to_char(batch_boundary AT TIME ZONE 'UTC', 'YYYY-MM-DD HH24:MI') END AS boundary\nFROM serving_boundary",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ]
    },
